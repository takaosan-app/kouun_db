[Unit]
Description=kouun_db daily JMA observation collection
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=masuday
Group=masuday
SupplementaryGroups=docker
WorkingDirectory=/opt/docker/kouun_db
Environment=COMPOSE_ANSI=never

ExecStartPre=/usr/bin/docker compose -f compose.yml --profile jobs config --quiet
ExecStart=/usr/bin/docker compose -f compose.yml --profile jobs run --rm collector python -m collector.batch_jma_daily --element-profile extended --output-dir /data/raw

TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
