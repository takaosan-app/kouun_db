[Unit]
Description=kouun_db daily host health report
OnSuccess=kouun-notify@health.service
OnFailure=kouun-notify@health.service

[Service]
Type=oneshot
User=masuday
Group=masuday
SupplementaryGroups=docker
WorkingDirectory=/opt/docker/kouun_db
ExecStart=/usr/bin/python3 /opt/docker/kouun_db/deploy/health/kouun_health.py
TimeoutStartSec=5min
