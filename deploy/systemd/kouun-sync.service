[Unit]
Description=kouun_db daily sync to the app database
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnSuccess=kouun-notify@sync.service
OnFailure=kouun-notify@sync.service

[Service]
Type=oneshot
User=masuday
Group=masuday
SupplementaryGroups=docker
WorkingDirectory=/opt/docker/kouun_db
Environment=COMPOSE_ANSI=never

ExecStartPre=-/usr/bin/python3 /opt/docker/kouun_db/deploy/notify/kouun_notify.py started sync
ExecStart=/usr/bin/docker compose -f compose.yml --profile jobs run --rm syncer python -m sync.sync_app_db

TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
