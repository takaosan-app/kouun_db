# Copy to /opt/docker/kouun_db/.env.notify and set permissions to 600.
# kouun_notify.py reads this file directly. Do not quote values.
#
# Only https URLs or loopback http URLs (127.0.0.1, localhost, ::1) are sent.
# The path differs per environment (e.g. /kouun_dev for development).
# Leave KOUUN_WEBHOOK_URL empty to record notifications in journald only.
KOUUN_WEBHOOK_URL=
KOUUN_WEBHOOK_TOKEN=
